{
  "name": "last-bell-high",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Engineers of the Elite - a 3D engineering university life game (Vite + TypeScript + Three.js)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
